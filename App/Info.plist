<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>tiAi</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!-- An MCP sign-in does not stay on the server you configured: the OAuth
		     dance hands the browser off to whatever the identity provider says
		     next, and on a self-hosted stack that is often plain HTTP on a real
		     hostname. `NSAllowsLocalNetworking` does not cover that — it only
		     exempts .local and LAN addresses — so the hand-off died with "App
		     Transport Security policy requires the use of a secure connection"
		     and the login page never appeared. This relaxes the rule for web view
		     content only; the app's own calls to your server still require TLS. -->
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Attaching a photo you just took. The picture goes to your own server and nowhere else.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>tiAi talks to your assistant on the local network when you point it at a LAN address instead of a hostname.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Voice mode records on this device and sends audio to your own server, if you turn it on.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Dictation for the composer is transcribed on this device.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
