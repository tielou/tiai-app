<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>tiAi</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Standard TLS only, so there is nothing to declare. Without this key
	     every TestFlight build lands flagged for export compliance and has to
	     be clicked through by hand. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- The whole point of this app is that the server is wherever the user's
	     server is, and plenty of people run Open WebUI on a LAN address with a
	     self-signed certificate. ATS is relaxed for local networking only; a
	     public hostname still has to be TLS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>tiAi talks to your assistant on the local network when you point it at a LAN address instead of a hostname.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Voice mode records on this device and sends audio to your own server, if you turn it on.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Dictation for the composer is transcribed on this device.</string>
</dict>
</plist>
